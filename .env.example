# Local-only values. Never commit a populated .env file.
MYSQL_ROOT_PASSWORD=change-me-locally
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# Optional, non-secret build-time list of exact canonical HTTPS origins for a private course demo.
# Empty retains loopback-only controls. Site-wide access protection is required before hosted use.
# Rebuild frontend after changing this value; a runtime container environment variable is insufficient.
VITE_DEMO_ALLOWED_ORIGINS=
